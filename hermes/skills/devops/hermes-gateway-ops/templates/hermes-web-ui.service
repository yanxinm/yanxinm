[Unit]
Description=Hermes Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=__USER__
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
PIDFile=__HOME__/.hermes-web-ui/server.pid
ExecStart=__HOME__/.hermes/node/bin/hermes-web-ui start
ExecStop=__HOME__/.hermes/node/bin/hermes-web-ui stop
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
