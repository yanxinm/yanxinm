[Unit]
Description=Hermes Dashboard
After=network-online.target hermes-web-ui.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
ExecStart=__HOME__/.hermes/hermes-agent/venv/bin/hermes dashboard --port 9119 --host 127.0.0.1 --no-open --skip-build
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
